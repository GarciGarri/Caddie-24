# ============================================================
# Caddie 24 — CRM para campos de golf
# Copia este archivo a .env y rellena los valores.
# ============================================================

# --- Base de datos (PostgreSQL, p. ej. Supabase o Neon) ---
# DATABASE_URL: conexión con pooling (runtime)
# DIRECT_URL: conexión directa (migraciones con `prisma migrate`)
DATABASE_URL="postgresql://user:password@localhost:5432/crm_golf"
DIRECT_URL="postgresql://user:password@localhost:5432/crm_golf"

# --- Autenticación (NextAuth v5) ---
# Genera el secreto con: npx auth secret  (o: openssl rand -base64 32)
AUTH_SECRET="generate-a-secret-key-here"
NEXTAUTH_URL="http://localhost:3000"

# --- IA (OpenAI: respuestas automáticas, chatbot, sugerencias) ---
OPENAI_API_KEY=""

# --- WhatsApp Business (Meta Cloud API) ---
# Las credenciales se guardan en BD desde Configuración → WhatsApp.
# El webhook de Meta debe apuntar a: https://tu-dominio/api/webhook/whatsapp

# --- Crons de Vercel (protege los endpoints /api/cron/*) ---
CRON_SECRET=""

# --- Notificaciones push web (opcional) ---
# Genera el par de claves con: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""

# --- Formulario de contacto de /presentacion (web3forms.com) ---
WEB3FORMS_KEY=""

# --- App ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"
